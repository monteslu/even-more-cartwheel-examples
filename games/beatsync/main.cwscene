[scene format=1]

[node name="Level" type="Node3D"]

[node name="Env" parent="." type="WorldEnvironment"]
background = color(0, 0, 0, 1)
use_background = true
ambient_energy = 0.12
hemi_energy = 0

[node name="Post" parent="." type="PostProcess"]
tonemap = NEUTRAL
bloom = true
bloom_intensity = 0.08
bloom_threshold = 1.0
aa = NONE
; the glass roads' sharp reflections of a backdrop (src/styles.c turns ssr and ssr_backdrop on for the styles that ask)
ssr_max_distance = 40

[node name="Camera" parent="." type="Camera3D"]
position = vec3(0, 0, 22)
fov = 40
near = 1
far = 1500
current = true

; the field's lights (src/club.c sets them from the style): they light only the lit picture (gems, the roads' glass)
[node name="Key" parent="." type="DirectionalLight3D"]
position = vec3(-4, 10, 12)
rotation = vec3(-0.75, -0.3, 0)
color = color(1, 1, 1, 1)
energy = 0

[node name="FillL" parent="." type="OmniLight3D"]
position = vec3(-9, -7, 7)
color = color(1, 1, 1, 1)
energy = 0
range = 40

[node name="FillR" parent="." type="OmniLight3D"]
position = vec3(9, -7, 7)
color = color(1, 1, 1, 1)
energy = 0
range = 40

; the backdrops (src/backdrop.c): worlds of their own drawn behind the field, faded by opacity, at most two at once;
; the sea, the grid, the stage and the metal hall light the field (environment: the glass roads reflect them; 64 texels a
; face: the roads blur them anyway, and the faces cost a quarter of 128)
[node name="BdFire" parent="." type="Backdrop"]
scene = "backdrops/fire.cwscene"
camera = "Camera"
opacity = 0

[node name="BdSea" parent="." type="Backdrop"]
scene = "backdrops/sea.cwscene"
camera = "Camera"
opacity = 0
environment = true
env_resolution = 64

