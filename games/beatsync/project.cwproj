; beatsync's settings (cartwheel/project.h), packed into the cart, and its release builds:
; node <host sdk>/tools/cwexport.mjs --project games/beatsync --preset <preset>
name = beatsync
app = beatsync
title = beatsync
main_scene = main.cwscene
app_id = org.cartwheel.beatsync
; The three lanes, left to right: the three lower face buttons (one thumb), J K L on a keyboard, three zones across
; the bottom of a touch screen in a native build (the touch controls added in init, in this order; in a cart the host
; draws its pad from the manifest's controls, which the build works out from these bindings: the three face buttons,
; the d-pad and Start for the menus). The menus' actions (ui_*, pause) come from the engine's shell.
input.lane_kick = key:j, pad:west, touch:0
input.lane_clap = key:k, pad:south, touch:1
input.lane_bass = key:l, pad:east, touch:2
render.width = 960
render.height = 540
render.msaa = 4
render.vsync = true
export.linux-x64.platform = linux-x64
export.linux-arm64.platform = linux-arm64
export.windows-x64.platform = windows-x64
export.macos-arm64.platform = macos
export.android-arm64.platform = android-arm64
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A house-music rhythm game on three buttons, drawn as neon characters: play the kick, the clap and the bass of six instrumental house tracks on Easy, Medium or Hard, and the song plays the way you play it. A miss ducks that part until your next hit."
author = "Luis Montes"
