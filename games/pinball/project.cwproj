; pinball's release builds: node <host sdk>/tools/cwexport.mjs --project games/pinball --preset <preset>
name = "Pinball"
app = "pinball"
app_id = "org.cartwheel.pinball"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Three original pinball tables, lit and rendered in 3D, for one to four players taking turns: ramps, pop bumpers, drop targets, spinners, modes, multiball and a dot display, on a ball solver made for pinball."
author = "Luis Montes"
