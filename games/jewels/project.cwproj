; jewels' release builds: node <host sdk>/tools/cwexport.mjs --project games/jewels --preset <preset>
name = "Jewels"
app = "jewels"
title = "Jewels"
app_id = "org.cartwheel.jewels"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A calm, untimed match-three of six cut stones, each its own shape and colour, light traced through their facets: no clock, a free hint, cascades that resolve slowly enough to follow. Pad, touch or mouse."
author = "Luis Montes"
