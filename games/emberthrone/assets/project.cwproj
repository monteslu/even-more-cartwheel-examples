; emberthrone project settings
name = Ember Throne
app = emberthrone
main_scene = scenes/main.cwscene
version = 0.1.0
app_id = org.cartwheel.emberthrone
; gameplay actions; the menus' (ui_*, pause) come from the engine's shell. Movement has the d-pad as well as the stick,
; and the camera follows by itself, so a pad with no sticks plays the whole game.
input.move_left = key:a, pad:left, axis:lx-
input.move_right = key:d, pad:right, axis:lx+
input.move_up = key:w, pad:up, axis:ly-
input.move_down = key:s, pad:down, axis:ly+
input.cam_left = key:left, axis:rx-
input.cam_right = key:right, axis:rx+
input.cam_up = key:up, axis:ry-
input.cam_down = key:down, axis:ry+
input.attack = key:j, mouse:left, pad:west
input.heavy = key:k, mouse:right, pad:north, axis:rt+@0.4
input.dodge = key:space, pad:south
input.use = key:e, pad:east
input.lock = key:l, key:tab, pad:rshoulder, pad:rstick
input.tonic = key:q, pad:lshoulder, axis:lt+@0.4
input.swap = key:f, pad:lstick
render.width = 1280
render.height = 720
render.msaa = 1
render.vsync = true
