; emberthrone's release builds: node <host sdk>/tools/cwexport.mjs --project games/emberthrone --preset <preset>
name = "Ember Throne"
app = "emberthrone"
version = "0.1.0"
app_id = "org.cartwheel.emberthrone"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A third-person action adventure through one connected world. The wanderer gathers the Sun Key and the Moon Key to open the Ember Keep and face the Ember King on his throne. Lock on with sword and maul, roll through the blows, find the hearts that open the way round. A second player can drop in."
author = "Luis Montes"
