; adventure's release builds: node <host sdk>/tools/cwexport.mjs --project games/adventure --preset <preset>
name = "Adventure"
app = "adventure"
version = "0.1.0"
app_id = "org.cartwheel.adventure"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A third-person action adventure through one connected world: lock on and fight with sword and maul, roll through the blows, find the keys and hearts that open the way round, and bring down three wardens. A second player can drop in at any time."
author = "Luis Montes"
