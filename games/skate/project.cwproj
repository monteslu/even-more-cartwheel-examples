; skate's release builds: node <host sdk>/tools/cwexport.mjs --project games/skate --preset <preset>
name = "Skate"
app = "skate"
version = "0.1.0"
app_id = "org.cartwheel.skate"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Skateboarding for one to four players in split screen: five sunny parks of bowls, quarter pipes, rails, ledges, a mega ramp and rooftops; flips, grabs, grinds and manuals linked into combos; free skate, a timed score attack with each park's goals, and score battles."
author = "Luis Montes"
