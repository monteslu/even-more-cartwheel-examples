; towers project settings
name = Towers
app = towers
main_scene = scenes/main.cwscene
version = 0.1.0
app_id = org.cartwheel.towers
; gameplay actions: a cursor that hops between pads (stick or d-pad), the four face buttons as the build diamond
; (north, west, east, south; on the keyboard I, J, L, K sit as a diamond), a shoulder to call the next wave; the
; menus' (ui_*, pause) come from the engine's shell
input.move_left = key:a, key:left, pad:left, axis:lx-
input.move_right = key:d, key:right, pad:right, axis:lx+
input.move_up = key:w, key:up, pad:up, axis:ly-
input.move_down = key:s, key:down, pad:down, axis:ly+
input.act_n = key:i, pad:north
input.act_w = key:j, pad:west
input.act_e = key:l, pad:east
input.act_s = key:k, key:space, pad:south
input.call = key:q, pad:rshoulder, pad:lshoulder
render.width = 1280
render.height = 720
render.msaa = 1
render.vsync = true
