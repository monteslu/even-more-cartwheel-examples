; detexto's release builds: node <host sdk>/tools/cwexport.mjs --project games/detexto --preset <preset>
name = "Detexto"
app = "detexto"
title = "Detexto"
app_id = "org.cartwheel.detexto"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Bring famous landmarks down in neon text: towers, bridges, temples and monuments drawn as glowing characters on black, breaking and falling for real under shot, heavy balls and charges, for one to four players taking turns."
author = "Luis Montes"
