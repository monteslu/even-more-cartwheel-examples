; lanternfall's release builds: node <host sdk>/tools/cwexport.mjs --project games/lanternfall --preset <preset>
name = "Lanternfall"
app = "lanternfall"
app_id = "org.cartwheel.lanternfall"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "A 2D exploration platformer. The lanterns of the old city have gone out: as the hooded lamplighter you wake its beacons across thirteen regions, each ability you find opening a way you could not take before. Six wardens, hidden relics, shrines to rest at and travel between, and a friend can drop in."
author = "Luis Montes"
