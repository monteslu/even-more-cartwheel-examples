; destructo's release builds: node <host sdk>/tools/cwexport.mjs --project games/destructo --preset <preset>
name = "Destructo"
app = "destructo"
app_id = "org.cartwheel.destructo"
export.linux-x64.platform = "linux-x64"
export.linux-arm64.platform = "linux-arm64"
export.windows-x64.platform = "windows-x64"
export.macos-arm64.platform = "macos"
export.android-arm64.platform = "android-arm64"
# launcher art and credits, packed into the cart (art/art.json)
art = art
description = "Bring down towers, walls, bridges, castles and scaffolds of wood, stone, glass and steel with a launcher, shot and charges: thirty structures of up to thousands of blocks that break and fall for real, for one to four players taking turns."
author = "Luis Montes"
