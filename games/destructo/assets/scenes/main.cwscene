[scene format=1]

; destructo's main scene: the sky, the sun, the camera and the picture's settings. The field, the structure and
; the launcher are built in code (src/view.c) under it.
[node name="Main" type="Node3D"]

[node name="Sky" parent="." type="ProceduralSky"]
sun = "../Sun"
time_of_day = 9.8
latitude = 38
declination = 14
north = 200
sun_energy = 3.4
sky_energy = 1.25
rayleigh = 0.8
mie = 3
environment = true

; the sun's shadow covers the structure and the yard round it (the light sits over the structure)
[node name="Sun" parent="." type="DirectionalLight3D"]
position = vec3(0, 6, 6)
shadow = true
shadow_size = 2048
shadow_cascades = 2
shadow_distance = 110
cascade_fade = true
shadow_far = 500
shadow_bias = -0.0006
shadow_normal_bias = 0.03

; the sky's light on the shaded faces: a hemisphere, blue above and the warm ground's bounce below (the sky above draws itself)
[node name="Ambient" parent="." type="WorldEnvironment"]
use_background = false
ambient_energy = 0
hemi_energy = 0.9
sky_color = color(0.42, 0.6, 1, 1)
ground_color = color(0.4, 0.34, 0.2, 1)

; a cool fill from the far side so the shaded faces keep their colour
[node name="Fill" parent="." type="DirectionalLight3D"]
rotation = vec3(-0.6, 2.6, 0)
color = color(0.45, 0.6, 1, 1)
energy = 0.5

[node name="Camera" parent="." type="Camera3D"]
position = vec3(4, 6, 36)
fov = 50
near = 0.2
far = 600

[node name="Lighting" parent="." type="LightingSettings"]
mode = CLUSTERED
shadow_atlas = false
cluster_far = 120

[node name="Post" parent="." type="PostProcess"]
msaa = 0
aa = SMAA
tonemap = ACES_FILMIC
exposure = 1.25
bloom = true
bloom_intensity = 0.09
bloom_threshold = 1.2
bloom_knee = 0.5
ssao = true
ssao_radius = 0.6
ssao_intensity = 1
ssao_power = 1.2
ssao_steps = 6
grade = true
lut = "grade/contrast.cube"
vignette = true
vignette_intensity = 0.4
vignette_smoothness = 0.6
